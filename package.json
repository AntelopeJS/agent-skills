{
  "name": "agent-skills",
  "version": "0.8.0",
  "private": true,
  "description": "AntelopeJS agent tools for Claude Code and OpenAI Codex: the sync of the skills shipped by AntelopeJS packages and the interface contract resolver.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/agent-skills.git"
  },
  "bin": {
    "agent-skills": "bin/agent-skills.mjs"
  },
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "evals:baseline": "node scripts/evals.mjs --published --skills plugin/skills --min-recall 0.5 --min-precision 0.5",
    "evals:check": "node scripts/evals.mjs check",
    "prepare": "if [ -e .git ] && command -v git >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1 && GIT_DIR=.git GIT_WORK_TREE=. git rev-parse --git-dir >/dev/null 2>&1; then GIT_DIR=.git GIT_WORK_TREE=. lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "typecheck": "pnpm --filter @antelopejs/agent-skills typecheck",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "check:plugin": "node scripts/check-plugin.mjs",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.5.1",
    "@types/node": "^24",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "packageManager": "pnpm@10.2.0"
}

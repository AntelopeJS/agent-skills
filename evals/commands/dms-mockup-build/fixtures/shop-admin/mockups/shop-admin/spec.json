{
  "$schema": "../../node_modules/@antelopejs/dms/data/mockup-spec.schema.json",
  "version": 1,
  "title": "Shop admin",
  "source": "claude-code",
  "categories": [
    {
      "id": "sales",
      "title": "Sales",
      "icon": "i-ph-storefront"
    },
    {
      "id": "catalog",
      "title": "Catalog",
      "icon": "i-ph-package"
    },
    {
      "id": "customers",
      "title": "Customers",
      "icon": "i-ph-users-three"
    }
  ],
  "pages": [
    {
      "id": "overview",
      "title": "Overview",
      "icon": "i-ph-chart-line-up",
      "description": "Revenue and orders of the shop",
      "fixtures": {
        "revenue-weekly": {
          "value": 48210,
          "delta": 12.4,
          "series": [
            {
              "name": "Revenue",
              "data": [
                { "x": "Week 41", "y": 9800 },
                { "x": "Week 42", "y": 11200 },
                { "x": "Week 43", "y": 12750 },
                { "x": "Week 44", "y": 14460 }
              ]
            }
          ]
        }
      },
      "tree": [
        {
          "id": "revenue",
          "type": "KpiCard",
          "options": {
            "title": "Revenue",
            "staticValue": 48210,
            "staticDelta": 12.4,
            "valueFormat": "number"
          }
        },
        {
          "id": "shortcuts",
          "type": "StatGroup",
          "options": {
            "layout": "cards",
            "items": [
              {
                "icon": "i-ph-shopping-cart",
                "eyebrow": "Orders this week",
                "value": 64,
                "to": "page:orders"
              },
              {
                "icon": "i-ph-lifebuoy",
                "tone": "warning",
                "eyebrow": "Open tickets",
                "value": 12,
                "to": "page:support-tickets"
              }
            ]
          }
        },
        {
          "id": "revenue-per-week",
          "type": "ChartCard",
          "options": {
            "title": "Revenue per week",
            "fetchUrl": "fixture:revenue-weekly",
            "valueFormat": "number"
          },
          "children": [
            {
              "id": "chart",
              "type": "ChartArea",
              "options": { "xaxisType": "category" }
            }
          ]
        }
      ]
    },
    {
      "id": "orders",
      "title": "Orders",
      "category": "sales",
      "icon": "i-ph-shopping-cart",
      "description": "Every order with its payment status",
      "fixtures": {
        "orders": {
          "$generate": {
            "fields": {
              "_id": "id",
              "number": "text",
              "customer": "company",
              "total": {
                "money": [20, 900]
              },
              "status": ["pending", "paid", "shipped", "refunded"],
              "ordered_at": "date"
            }
          }
        }
      },
      "tree": [
        {
          "id": "orders-table",
          "type": "TableView",
          "options": {
            "fetchUrl": "fixture:orders",
            "caption": "Orders",
            "columns": {
              "number": {
                "name": "Order",
                "type": "string",
                "sortable": true
              },
              "customer": {
                "name": "Customer",
                "type": "string"
              },
              "total": {
                "name": "Total",
                "type": "number",
                "sortable": true,
                "display": {
                  "kind": "price",
                  "currency": "EUR"
                }
              },
              "status": {
                "name": "Status",
                "type": "select",
                "filterable": true,
                "display": {
                  "kind": "badge",
                  "items": [
                    {
                      "value": "pending",
                      "label": "Pending",
                      "tone": "warning"
                    },
                    {
                      "value": "paid",
                      "label": "Paid",
                      "tone": "success"
                    },
                    {
                      "value": "shipped",
                      "label": "Shipped",
                      "tone": "info"
                    },
                    {
                      "value": "refunded",
                      "label": "Refunded",
                      "tone": "error"
                    }
                  ]
                }
              },
              "ordered_at": {
                "name": "Ordered",
                "type": "date",
                "sortable": true,
                "filterable": true
              }
            },
            "tabsFrom": {
              "column": "status"
            },
            "views": {
              "items": [
                {
                  "id": "this-week",
                  "label": "This week",
                  "count": true,
                  "filters": [
                    {
                      "accessorKey": "ordered_at",
                      "mode": "greater_than",
                      "value": "{{now-7d}}"
                    }
                  ],
                  "sort": [
                    {
                      "field": "ordered_at",
                      "desc": true
                    }
                  ]
                },
                {
                  "id": "large",
                  "label": "Large orders",
                  "sort": [
                    {
                      "field": "total",
                      "desc": true
                    }
                  ]
                }
              ],
              "layout": "strip"
            },
            "rowClick": "single",
            "rowActions": {
              "add": true,
              "edit": true,
              "custom": [
                {
                  "label": "Open",
                  "icon": "i-ph-arrow-right",
                  "isDefault": true,
                  "target": {
                    "type": "page",
                    "url": "page:order"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "order",
      "title": "Order",
      "menu": false,
      "parent": "orders",
      "route": ":id",
      "icon": "i-ph-receipt",
      "description": "One order with its customer, total and status",
      "tree": [
        {
          "id": "order-details",
          "type": "ResourceForm",
          "options": {
            "fetchUrl": "fixture:orders",
            "backTo": "page:orders",
            "fields": [
              {
                "id": "number",
                "label": "Order",
                "type": "string"
              },
              {
                "id": "customer",
                "label": "Customer",
                "type": "string"
              },
              {
                "id": "total",
                "label": "Total",
                "type": "number"
              },
              {
                "id": "status",
                "label": "Status",
                "type": "string"
              },
              {
                "id": "ordered_at",
                "label": "Ordered",
                "type": "date"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "payments",
      "title": "Payments",
      "category": "sales",
      "icon": "i-ph-credit-card",
      "description": "Every payment received or refunded",
      "fixtures": {
        "payments": {
          "$generate": {
            "fields": {
              "_id": "id",
              "reference": "text",
              "amount": {
                "money": [20, 900]
              },
              "paid_at": "date"
            }

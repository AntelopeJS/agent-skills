        }
      },
      "tree": [
        {
          "id": "payments-table",
          "type": "TableView",
          "options": {
            "fetchUrl": "fixture:payments",
            "caption": "Payments",
            "columns": {
              "reference": {
                "name": "Reference",
                "type": "string"
              },
              "amount": {
                "name": "Amount",
                "type": "number",
                "sortable": true,
                "display": {
                  "kind": "price",
                  "currency": "EUR"
                }
              },
              "paid_at": {
                "name": "Paid",
                "type": "date",
                "sortable": true
              }
            },
            "grouped": {
              "groupByField": "paid_at",
              "by": "day"
            }
          }
        }
      ]
    },
    {
      "id": "products",
      "title": "Products",
      "category": "catalog",
      "icon": "i-ph-t-shirt",
      "description": "The catalogue with stock and price",
      "fixtures": {
        "products": {
          "$generate": {
            "fields": {
              "_id": "id",
              "name": "name",
              "image": "text",

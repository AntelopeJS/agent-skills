              {
                "id": "table"
              },
              {
                "id": "cards"
              }
            ],
            "card": {
              "fields": ["image", "price", "stock"]
            },
            "defaultDisplay": "cards",
            "rowActions": {
              "add": true,
              "edit": true,
              "details": true
            },
            "formContainer": {
              "type": "page",
              "pages": {
                "new": {
                  "urlSlug": "page:product-new",
                  "customPage": true
                },
                "edit": {
                  "urlSlug": "page:product-edit",
                  "customPage": true
                },
                "details": {
                  "urlSlug": "page:product",
                  "customPage": true
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "product-new",

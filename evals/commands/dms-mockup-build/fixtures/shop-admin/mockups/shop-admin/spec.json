            }
          }
        }
      },
      "tree": [
        {
          "id": "products-table",
          "type": "TableView",
          "options": {
            "fetchUrl": "fixture:products",
            "caption": "Products",
            "columns": {
              "name": {
                "name": "Product",
                "type": "string",
                "sortable": true
              },
              "image": {
                "name": "Image",
                "type": "string"
              },
              "price": {
                "name": "Price",
                "type": "number",
                "sortable": true,
                "display": {
                  "kind": "price",
                  "currency": "EUR"
                }
              },
